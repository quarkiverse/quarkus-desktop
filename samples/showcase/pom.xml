<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.quarkiverse.desktop.showcase</groupId>
    <artifactId>quarkus-desktop-showcase</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Quarkus Desktop Showcase</name>
    <description>Exercises AWT, Java2D, Swing and SWT features through quarkus-desktop, to compare JVM and native rendering</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.version>3.40.0</quarkus.platform.version>
        <quarkus-desktop.version>999-SNAPSHOT</quarkus-desktop.version>
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <!-- The quarkus-desktop extension of the variant : quarkus-desktop-swing (default), quarkus-desktop-awt (awt-only)
             or quarkus-desktop-swt (swt), see the profiles. A property rather than a profile per extension : a profile
             is activated by one property only (the default variant would be !awt-only AND !swt) -->
        <showcase.extension>quarkus-desktop-swing</showcase.extension>
        <!-- core/Foreground : native access for the Foreign Function and Memory API (see application.properties). Here and
             not in application.properties, which would override the value of the mac profile -->
        <quarkus.native.additional-build-args-append>--enable-native-access=ALL-UNNAMED</quarkus.native.additional-build-args-append>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.desktop</groupId>
            <artifactId>${showcase.extension}</artifactId>
            <version>${quarkus-desktop.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <!-- the SWT variant only (see the swt profile) -->
                    <excludes>
                        <exclude>io/quarkiverse/desktop/showcase/swt/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                AWT only variant (-Dawt-only) : AWT main window, AWT pages, quarkus-desktop-awt alone. The application
                classes using javax.swing are neither compiled nor CDI beans, so the executable contains no application
                Swing code. It is built into target/awt-only, next to the default variant.
            -->
            <id>awt-only</id>
            <activation>
                <property>
                    <name>awt-only</name>
                </property>
            </activation>
            <properties>
                <showcase.extension>quarkus-desktop-awt</showcase.extension>
                <quarkus.arc.exclude-types>io.quarkiverse.desktop.showcase.pages.swing.**,io.quarkiverse.desktop.showcase.pages.laf.**,io.quarkiverse.desktop.showcase.ui.swing.**</quarkus.arc.exclude-types>
            </properties>
            <build>
                <directory>${project.basedir}/target/awt-only</directory>
                <plugins>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>${compiler-plugin.version}</version>
                        <configuration>
                            <!-- appended to the exclusion of the swt package -->
                            <excludes combine.children="append">
                                <exclude>io/quarkiverse/desktop/showcase/pages/swing/**</exclude>
                                <exclude>io/quarkiverse/desktop/showcase/pages/laf/**</exclude>
                                <exclude>io/quarkiverse/desktop/showcase/ui/swing/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
                macOS : the capture of the AWT components (core/MacPeers) reads java.awt.Component#peer and calls
                sun.lwawt.LWComponentPeer#getDelegate() with reflection (tools/Snapshot.java passes the same add-opens to
                the JVM)
            -->
            <id>mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <quarkus.native.additional-build-args-append>--enable-native-access=ALL-UNNAMED,--add-opens=java.desktop/java.awt=ALL-UNNAMED,--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</quarkus.native.additional-build-args-append>
            </properties>
        </profile>
        <profile>
            <!--
                SWT variant (-Dswt) : SWT main window, SWT pages, quarkus-desktop-swt alone (not with -Dawt-only). Only
                the classes of io.quarkiverse.desktop.showcase.swt and the toolkit neutral core/Check.java and
                core/Json.java are compiled, and only application.properties and the SWT assets (showcase/swt/**) are
                packaged : the executable contains no application AWT or Swing code, and none of the AWT configuration
                of the other variants (META-INF/native-image, the ImageIO services). It is built into target/swt, next to
                the default variant. Declared after the mac profile : its native options replace those of the mac
                profile (core/MacPeers is AWT only).
            -->
            <id>swt</id>
            <activation>
                <property>
                    <name>swt</name>
                </property>
            </activation>
            <properties>
                <showcase.extension>quarkus-desktop-swt</showcase.extension>
                <quarkus.native.additional-build-args-append>--enable-native-access=ALL-UNNAMED</quarkus.native.additional-build-args-append>
            </properties>
            <build>
                <directory>${project.basedir}/target/swt</directory>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <includes>
                            <include>application.properties</include>
                            <include>showcase/swt/**</include>
                        </includes>
                    </resource>
                    <!-- The reachability metadata of the SWT variant (the one of src/main/resources is for AWT and
                         Swing) : the configuration files that Quarkus looks for, for exact reachability metadata -->
                    <resource>
                        <directory>src/main/swt-resources</directory>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>${compiler-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>io/quarkiverse/desktop/showcase/swt/**</include>
                                <include>io/quarkiverse/desktop/showcase/core/Check.java</include>
                                <include>io/quarkiverse/desktop/showcase/core/Json.java</include>
                            </includes>
                            <!-- replaces the exclusion of the swt package -->
                            <excludes combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
            </properties>
        </profile>
    </profiles>
</project>
