<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>23</version>
    </parent>

    <groupId>io.quarkiverse.desktop</groupId>
    <artifactId>quarkus-desktop-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Quarkus Desktop - Parent</name>
    <description>Quarkus extensions for AWT, Swing and SWT desktop (GUI) applications, in JVM mode and as GraalVM native executables</description>

    <modules>
        <module>awt</module>
        <module>swing</module>
        <module>swt</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:quarkiverse/quarkus-desktop.git</connection>
        <developerConnection>scm:git:git@github.com:quarkiverse/quarkus-desktop.git</developerConnection>
        <url>https://github.com/quarkiverse/quarkus-desktop</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <quarkus.version>3.40.0</quarkus.version>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The last SWT release that runs on Java 17 (SWT 3.133.0 and later need Java 21) : an application on Java 21 or
             later can depend on a later SWT release. Not swt.version : SWT reads a system property of that name (the
             version of its native libraries), which Maven passes to the tests -->
        <version.swt>3.132.0</version.swt>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The SWT host bundle : the profiles of its pom add the SWT jar of the operating system and architecture of
                 the build (org.eclipse.platform:org.eclipse.swt.<ws>.<os>.<arch>) -->
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt</artifactId>
                <version>${version.swt}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-extension-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-config-doc-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>docs</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>!true</value>
                </property>
            </activation>
            <modules>
                <module>docs</module>
            </modules>
        </profile>
    </profiles>
</project>
